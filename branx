#!/usr/bin/env bash
set -e

# Usage:
#   branx clone <repo> [--source-branch BRANCH] [--target-dir DIR] [--target-branch BRANCH]
#   branx random

# Config
default_config_file="$HOME/.config/branx/env"
config_required=false
if [[ -v BRANX_CONFIG_FILE ]]; then
	config_file="$BRANX_CONFIG_FILE"
	config_required=true
else
	config_file="$default_config_file"
fi

declare -A REPOS
declare -a WORK_DIR_RULE_PATTERNS=()
declare -a WORK_DIR_RULE_TARGETS=()
WORK_DIR="${HOME}/.local/share/branx"
COPY_TO_CLIPBOARD=true

work_dir_rule() {
	local pattern="$1"
	local target="$2"
	WORK_DIR_RULE_PATTERNS+=("$pattern")
	WORK_DIR_RULE_TARGETS+=("$target")
}

# Config file expect this:
# REPOS[myrepo]="$HOME/code/myrepo/"
# REPOS[myproject]="https://github.com/myuser/myproject.git"
# WORK_DIR="$HOME/.local/share/branx"
# COPY_TO_CLIPBOARD=true
# work_dir_rule "/Codes/org-1/*" "/WorkSpaces/org-1"

if [[ -e "$config_file" ]]; then
	if [[ ! -r "$config_file" ]]; then
		echo "Error: config file is not readable: $config_file" >&2
		exit 1
	fi
	# shellcheck source=/dev/null
	source "$config_file"
elif [[ "$config_required" == true ]]; then
	echo "Error: BRANX_CONFIG_FILE is set but file is missing: $config_file" >&2
	exit 1
fi

# Helper functions
usage() {
	echo "Usage:"
	echo "  $0 clone <repo> [--source-branch <branch>] [--target-dir <dir>] [--target-branch <branch>]"
	echo "  $0 random"
}

usage_error() {
	echo "Error: $1" >&2
	usage >&2
	exit 1
}

copy_to_clipboard() {
	local text="$1"
	if command -v pbcopy &>/dev/null; then
		printf '%s' "$text" | pbcopy
	elif command -v xclip &>/dev/null; then
		printf '%s' "$text" | xclip -selection clipboard
	elif command -v xsel &>/dev/null; then
		printf '%s' "$text" | xsel --clipboard --input
	else
		echo "Warning: No clipboard utility found (pbcopy, xclip, or xsel)"
		return 1
	fi
}

