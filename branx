resolve_repo() {
	local repo="$1"
	if [[ -v REPOS[$repo] ]]; then
		echo "${REPOS[$repo]}"
	else
		echo "$repo"
	fi
}

select_work_dir_root() {
	local resolved_repo="$1"
	local i
	local pattern
	for i in "${!WORK_DIR_RULE_PATTERNS[@]}"; do
		pattern="${WORK_DIR_RULE_PATTERNS[$i]}"
		# shellcheck disable=SC2053
		if [[ "$resolved_repo" == $pattern ]]; then
			echo "${WORK_DIR_RULE_TARGETS[$i]}"
			return 0
		fi
	done
	echo "$WORK_DIR"
}

parse_clone_args() {
	clone_repo_arg=""
	source_branch=""
	requested_target_dir=""
	target_branch=""

	while (($# > 0)); do
		case "$1" in
			-s|--source-branch|--source-repo-branch)
				if (($# < 2)); then
					usage_error "$1 requires a value"
				fi
				source_branch="$2"
				shift 2
				;;
			-d|--target-dir)
				if (($# < 2)); then
					usage_error "$1 requires a value"
				fi
				requested_target_dir="$2"
				shift 2
				;;
			-t|--target-branch|--target-repo-branch)
				if (($# < 2)); then
					usage_error "$1 requires a value"
				fi
				target_branch="$2"
				shift 2
				;;
			-h|--help)
				usage
				exit 0
				;;
			--)
				shift
				while (($# > 0)); do
					if [[ -z "$clone_repo_arg" ]]; then
						clone_repo_arg="$1"
					else
						usage_error "unexpected positional argument: $1"
					fi
					shift
				done
				;;
			-*)
				usage_error "unknown option: $1"
				;;
			*)
				if [[ -z "$clone_repo_arg" ]]; then
					clone_repo_arg="$1"
				else
					usage_error "unexpected positional argument: $1"
				fi
				shift
				;;
		esac
	done

	if [[ -z "$clone_repo_arg" ]]; then
		usage_error "repo is required"
	fi

	if [[ -z "$target_branch" ]]; then
		target_branch=$(random_branch_name)
	fi
}

resolve_origin_head_ref() {
	git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true
}

switch_to_target_branch() {
	local desired_branch="$1"
	local start_point="$2"
	local upstream_ref="$3"
	local current_branch

	current_branch=$(git branch --show-current)

	if git show-ref --verify --quiet "refs/heads/$desired_branch"; then
		if [[ "$current_branch" == "$desired_branch" ]]; then
			if [[ -n "$start_point" ]]; then
				git reset --hard "$start_point" >/dev/null
			fi
		else
			if [[ -n "$start_point" ]]; then
				git branch -f "$desired_branch" "$start_point" >/dev/null
			fi
			git switch "$desired_branch" >/dev/null
		fi
	else
		if [[ -n "$start_point" ]]; then
			git switch -c "$desired_branch" "$start_point" >/dev/null
		else
			git switch -c "$desired_branch" >/dev/null
		fi
	fi

	if [[ -n "$upstream_ref" ]]; then
		git branch --set-upstream-to="$upstream_ref" "$desired_branch" >/dev/null 2>&1 || true
	fi
}

# Main
subcommand="${1:-}"
if (($# > 0)); then
	shift
fi

case "$subcommand" in
	clone)
		parse_clone_args "$@"

		repo=$(resolve_repo "$clone_repo_arg")
		repo_name=$(basename "$repo" .git)
		if [[ -n "$requested_target_dir" ]]; then
			target_dir="$requested_target_dir"
		else
			work_dir_root=$(select_work_dir_root "$repo")
			target_dir="${work_dir_root}/${repo_name}/${target_branch}"
		fi

		mkdir -p "$(dirname "$target_dir")"
		git clone "$repo" "$target_dir"
		cd "$target_dir"

		# If cloned from a local dir, preserve only the source repo's origin remote and sync with it.
		if [[ -d "$repo" ]]; then
			origin_url=$(git -C "$repo" remote get-url origin 2>/dev/null) || true
			git remote remove origin 2>/dev/null || true
			if [[ -n "$origin_url" ]]; then
				git remote add origin "$origin_url"
				git fetch origin
				git remote set-head origin --auto
			fi
		fi

		start_point=""
		upstream_ref=""
		if [[ -n "$source_branch" ]]; then
			if git rev-parse --verify "origin/$source_branch" >/dev/null 2>&1; then
				start_point="origin/$source_branch"
				upstream_ref="origin/$source_branch"
			else
				echo "Error: origin/$source_branch does not exist" >&2
				exit 1
			fi
		elif git rev-parse --verify origin/HEAD >/dev/null 2>&1; then
			start_point="origin/HEAD"
			upstream_ref=$(resolve_origin_head_ref)
		fi

		switch_to_target_branch "$target_branch" "$start_point" "$upstream_ref"

		echo "Cloned $repo to $target_dir"

		# Copy target directory to clipboard if enabled
		if [[ "$COPY_TO_CLIPBOARD" == true ]]; then
			if copy_to_clipboard "$target_dir"; then
				echo "Copied to clipboard: $target_dir"
			fi
		fi
		;;
	random)
		random_branch_name
		;;
	*)
		usage
		exit 1
		;;
esac
